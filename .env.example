# Garden State Abolitionists — Environment Variables
# Copy to .env.local and fill in the values. See README.md for details.

# ============================================
# DATABASE (Neon Postgres)
# ============================================
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# ============================================
# AUTHENTICATION (REQUIRED)
# ============================================

# Sign auth cookie + unsubscribe HMAC tokens. Must be >=32 chars.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Admin login email + bcrypt password hash + access code + high-impact PIN.
# Password hash: node -e "require('bcryptjs').hash('your-password', 10).then(console.log)"
ADMIN_EMAIL=admin@gardenstateabolitionists.org
ADMIN_PASSWORD_HASH=
ADMIN_ACCESS_CODE=
ADMIN_PIN=

# ============================================
# EMAIL (Resend transactional API)
# ============================================
# From resend.com dashboard. Requires the sending domain to be verified.
RESEND_API_KEY=
# From address must be on the verified domain. Defaults to
# "Garden State Abolitionists <ADMIN_EMAIL>" if unset.
# RESEND_FROM=Garden State Abolitionists <noreply@gardenstateabolitionists.org>
# RESEND_FROM_NOTIFICATIONS=Garden State Abolitionists <noreply@gardenstateabolitionists.org>
# Where admin notification emails land (petition, contact, subscribe alerts).
# Falls back to ADMIN_EMAIL.
# NOTIFICATION_EMAIL=

# ============================================
# RATE LIMITING (Upstash Redis REST)
# ============================================
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============================================
# SITE
# ============================================
NEXT_PUBLIC_SITE_URL=https://gardenstateabolitionists.org

# ============================================
# OPTIONAL — Vercel preview CSRF allowance
# ============================================
# Set to your Vercel project slug (e.g. "garden-state-abolitionists-website")
# so preview URLs <slug>-<branch>-<team>.vercel.app pass CSRF.
# Leave unset in local dev.
# VERCEL_PREVIEW_PROJECT_SLUG=

# ============================================
# OBSERVABILITY (PostHog + Sentry)
# ============================================
# PostHog project API key (product analytics + optional session replay).
# From posthog.com project settings.
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry DSN — same DSN for browser and server; source-map upload uses the
# auth token in the second block. From sentry.io project settings.
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=          # same value; used server-side if NEXT_PUBLIC_ isn't set
# SENTRY_ORG=          # e.g. "garden-state-abolitionists"
# SENTRY_PROJECT=      # e.g. "garden-state-abolitionists"
# SENTRY_AUTH_TOKEN=   # for source-map uploads at build time (Vercel only)

# ============================================
# OPTIONAL — SEO
# ============================================
# Google Search Console verification code (drop the site-tag value here).
# NEXT_PUBLIC_GSC_VERIFICATION=
# Bing Webmaster Tools verification (msvalidate.01 content value).
# NEXT_PUBLIC_BING_VERIFICATION=
# Pinterest domain verification (p:domain_verify content value).
# NEXT_PUBLIC_PINTEREST_DOMAIN_VERIFY=

# ============================================
# NONPROFIT DISCLOSURE (required for Google Ad Grants approval)
# ============================================
# Federal Tax ID / EIN — 9 digits, no dashes. Add via CLI:
#   vercel env add NEXT_PUBLIC_ORG_EIN production --no-sensitive
# NEXT_PUBLIC_ORG_EIN=XX-XXXXXXX
# Public URL to the IRS Determination Letter (proof of 501(c)(3) status).
# Available from apps.irs.gov/pub/epostcard after IRS grants exemption.
# NEXT_PUBLIC_IRS_DETERMINATION_LETTER_URL=
# Public URL to the most recent IRS Form 990 (once filed).
# NEXT_PUBLIC_FORM_990_URL=
# Public URL to the annual report (once published).
# NEXT_PUBLIC_ANNUAL_REPORT_URL=

# ============================================
# OPTIONAL — Google Analytics 4 (GA4)
# ============================================
# GA4 measurement id (from analytics.google.com property settings). One
# gtag.js loader handles both this and the Ads id below — safe to set
# either or both. Add via CLI with `--no-sensitive`.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================
# OPTIONAL — Google Ad Grants
# ============================================
# Set these AFTER Ad Grants is activated and conversion actions are created
# in Google Ads UI. Add via CLI with `--no-sensitive` (they're client-side).
# Without them, the site runs normally and no gtag script loads.
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXX
# NEXT_PUBLIC_GOOGLE_ADS_CONV_PETITION=AW-XXXXXXXXX/aaaaaaaaaaa
# NEXT_PUBLIC_GOOGLE_ADS_CONV_INQUIRY=AW-XXXXXXXXX/bbbbbbbbbbb
# NEXT_PUBLIC_GOOGLE_ADS_CONV_NEWSLETTER=AW-XXXXXXXXX/ccccccccccc
# NEXT_PUBLIC_GOOGLE_ADS_CONV_DONATE=AW-XXXXXXXXX/ddddddddddd

# ============================================
# ORGANIZATION IDENTITY (public — set with --no-sensitive on Vercel)
# ============================================
# These drive the footer disclosures, /financial-transparency, /donate and the
# homepage JSON-LD. Anything left blank is HIDDEN rather than rendered empty,
# so the site never publishes a placeholder as if it were fact.

# Public contact address shown on /contact and in structured data.
# NEXT_PUBLIC_CONTACT_EMAIL=

# Zeffy donation-form URL. The slug is assigned by Zeffy when the form is
# created and cannot be guessed from the org name. Until this is set, the
# donate CTAs render a "coming soon" notice instead of a broken link.
# NEXT_PUBLIC_ZEFFY_URL=

# 9-digit IRS EIN, once issued. Required for a Google Ad Grants application.
# NEXT_PUBLIC_ORG_EIN=

# Public URL of the IRS determination letter / Form 990 / annual report.
# NEXT_PUBLIC_IRS_DETERMINATION_LETTER_URL=
# NEXT_PUBLIC_FORM_990_URL=
# NEXT_PUBLIC_ANNUAL_REPORT_URL=

# ============================================
# ANTI-SPAM (Cloudflare Turnstile)
# ============================================
# NEXT_PUBLIC_TURNSTILE_SITE_KEY must be added with --no-sensitive or it will
# not be inlined into the client bundle and the widget silently never renders.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ============================================
# IMAGE UPLOADS (Cloudinary)
# ============================================
# Powers the "Upload from your computer" button in the admin gallery and news
# editor. All three are required; if any is missing the upload button reports
# that it is unconfigured and the paste-a-URL field remains the working path.
#
# CLOUDINARY_API_SECRET is server-only and must NEVER be prefixed NEXT_PUBLIC_.
# Uploads are signed server-side and sent straight from the browser to
# Cloudinary, so the secret never reaches the client.
# From the Cloudinary dashboard: Settings > API Keys.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
